{
  "name": "java-learning-center",
  "productName": "Java学习中心",
  "version": "1.3.4",
  "description": "闯关式 Java 零基础学习桌面软件",
  "main": "main.js",
  "author": {
    "name": "Shao-qichao",
    "url": "https://github.com/Shao-qichao"
  },
  "license": "MIT",
  "homepage": "https://github.com/Shao-qichao/learn",
  "scripts": {
    "start": "electron .",
    "selfcheck": "electron . --selfcheck",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:all": "electron-builder --win nsis --mac dmg --linux AppImage deb"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shaoqichao.javalearningcenter",
    "productName": "Java学习中心",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Shao-qichao",
        "repo": "learn"
      }
    ],
    "files": [
      "main.js",
      "updater.js",
      "updater-core.js",
      "update-preload.js",
      "update-notifier.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../java-course-site",
        "to": "site",
        "filter": [
          "**/*",
          "!tools/**"
        ]
      },
      {
        "from": "../javacourse",
        "to": "practice"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "Java学习中心",
      "shortcutName": "Java学习中心",
      "deleteAppDataOnUninstall": false,
      "artifactName": "JavaLearningCenter-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "JavaLearningCenter-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "JavaLearningCenter-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "Shao-qichao",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "JavaLearningCenter-${version}-${arch}.${ext}"
    }
  }
}
